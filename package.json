{
  "name": "bedrock-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Autonomous Minecraft Bedrock agent: Script API body + Python brain",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:brain": "python -m unittest discover -s brain/tests -t .",
    "typecheck": "tsc -p .",
    "fuzz": "node tools/fuzz_motor.mjs",
    "sim": "node tools/sim_plan.mjs",
    "gate": "node sim/gate.mjs",
    "gate:quick": "node sim/gate.mjs --quick"
  },
  "devDependencies": {
    "@minecraft/server": "2.11.0-beta.1.26.51-stable",
    "@minecraft/server-gametest": "1.0.0-beta.1.26.51-stable",
    "@minecraft/server-net": "1.0.0-beta.1.26.51-stable",
    "typescript": "^5"
  }
}
